generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                 Int       @id @default(autoincrement())
  username           String    @unique @db.VarChar(80)
  name               String    @db.VarChar(160)
  passwordHash       String    @db.VarChar(100)
  active             Boolean   @default(true)
  isAdmin            Boolean   @default(false)
  mustChangePassword Boolean   @default(true)
  theme              String    @default("clean") @db.VarChar(5)
  sessions           Session[]
  memberships        ProjectMember[]
  favorites          Favorite[]
  assignedTasks ProjectTask[]
  @@map("users")
}

model Session {
  tokenHash String   @id @db.Char(64)
  expiresAt DateTime
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("user_sessions")
}

model Project {
  id          Int       @id @default(autoincrement())
  name        String    @db.VarChar(180)
  category    String    @db.VarChar(120)
  description String    @db.Text
  status      String    @default("active") @db.VarChar(20)
  progress    Int       @default(0)
  deadline    DateTime? @db.Date
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  members     ProjectMember[]
  favorites   Favorite[]
  tasks       ProjectTask[]
  assets      ProjectAsset[]
  transactions ProjectTransaction[]
  @@index([status, deadline])
  @@map("projects")
}

model ProjectMember {
  projectId Int
  userId    Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([projectId, userId])
  @@index([userId])
  @@map("project_members")
}

model Favorite {
  projectId Int
  userId    Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, projectId])
  @@index([projectId])
  @@map("project_favorites")
}

model ProjectTask {
  id          Int      @id @default(autoincrement())
  projectId   Int
  title       String   @db.VarChar(180)
  description String   @db.Text
  pic         String   @db.VarChar(160)
  deadline    DateTime? @db.Date
  done        Boolean  @default(false)
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  @@index([projectId, id])
  assigneeId Int?
  assignee User? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  @@index([assigneeId])
  @@map("project_tasks")
}

model ProjectAsset {
  id Int @id @default(autoincrement())
  projectId Int
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  name String @db.VarChar(180)
  kind String @db.VarChar(10)
  mime String @db.VarChar(40)
  storageKey String @unique @db.Char(48)
  size Int
  createdAt DateTime @default(now())
  @@index([projectId, kind, id])
  @@map("project_assets")
}

model ProjectTransaction {
  id Int @id @default(autoincrement())
  projectId Int
  project Project @relation(fields: [projectId], references: [id], onDelete: Restrict)
  kind String @db.VarChar(3)
  amount Decimal @db.Decimal(16, 2)
  description String @db.VarChar(255)
  date DateTime @db.Date
  @@index([projectId, date])
  @@map("project_transactions")
}
